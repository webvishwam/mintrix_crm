# Copy to .env.local and fill in. In production, set the same names in the host's
# environment-variable settings (Vercel, Render, ...) — do not upload this file.

# --- Browser-safe -----------------------------------------------------------
# Every table has RLS, so these reach only what a signed-in user's policies allow.
# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
